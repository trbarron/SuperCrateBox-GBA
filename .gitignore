# Build output
# main.gba is the distributable ROM and stays tracked; everything else the
# Makefile produces is regenerated by "make".
*.o
*.elf
depend.mk

# Emulator files
# Written next to the ROM: *.sav holds the cartridge SRAM (the high score),
# *.ss* are savestates.
*.sav
*.ss?
*.ss??

